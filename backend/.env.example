SECRET_KEY=django-insecure-crm-lite-super-secret-key-change-in-production-2026!#
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Leave DB_ENGINE empty or set to sqlite3 for local development fallback
DB_ENGINE=sqlite3
DB_NAME=crm_lite.db
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# PostgreSQL Example:
# DB_ENGINE=postgresql
# DB_NAME=crm_lite_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Configuration
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7
